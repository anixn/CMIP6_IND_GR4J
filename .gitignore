# ============================================================
# .gitignore -- CIMP6_India / CAMELS-IND GR4J workflow
# Rule: code, notebooks, small result tables and manuscripts are tracked;
#       bulk data (raw downloads, corrected series, per-catchment inputs)
#       is regenerable from the notebooks and stays out of git.
# ============================================================

# ---- raw data (GBs; re-downloadable) ----
data_raw/
data_raw_backup/
*.nc

# ---- QED_05 working aggregates at data_processed root (5.2 GB; ----
# ---- regenerate with QED_05_aggregate_cmip6.Rmd from raw nc)   ----
data_processed/*.csv

# ---- QM fit parameters (15,972 small files; regenerate with ----
# ---- QED_20_qm_fit_apply.Rmd; needed locally for the SSP leg) ----
data_processed/qed/qm_params/

# ---- processed bulk series (GBs; regenerate with QED_30 / HYD_10) ----
data_processed/qed/qm_corrected/
data_processed/hyd/model_inputs/

# ---- SSP leg bulk outputs (regenerate with QED_50_ssp_apply.Rmd) ----
# policy-scoped trees: qm_corrected_linear/ (reported), qm_corrected_constant/
# (H4 tail-policy level only)
data_processed/ssp/qm_params*/
data_processed/ssp/qm_corrected*/

# ---- SSP aggregation CSVs (~100 MB each, 168 combos; regenerate with ----
# ---- QED_40_ssp_aggregate.Rmd from the raw nc archive)                ----
data_processed/ssp/agg_*.csv

# ---- low-flow / propagation / GR6J bulk series (GBs; regenerate) ----
data_processed/lowflow/series/
data_processed/prop/qsim_full/
data_processed/gr6j/params/
data_processed/gr6j/series/
data_processed/gr6j/lowflow/series/

# ---- Track-B benchmark bulk series (3.6 GB; regenerate with BENCH_00) ----
data_processed/bench/q_lstm/
data_processed/bench/q_stage/

# ---- rendered notebooks (regenerate by knitting) ----
*.html

# ---- LaTeX build artefacts ----
*.aux
*.log
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.lof
*.lot

# ---- R session artefacts ----
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ---- OS noise ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- editor noise ----
.vscode/
.idea/
